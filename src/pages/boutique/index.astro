---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Footer from '../../components/Footer.astro';
import { products, categories } from '../../data/products.js';
---
<Layout title="Boutique — Maison Khoudia">

  <!-- Compact page header (no big hero) -->
  <div class="pt-24 sm:pt-28 lg:pt-36 pb-5 px-4 sm:px-6 lg:px-8 bg-white border-b border-cream-dark">
    <div class="max-w-8xl mx-auto">
      <nav class="breadcrumb mb-2">
        <a href="/" class="text-luxury-gray hover:text-gold">Accueil</a>
        <span class="text-gold/40 mx-1.5">›</span>
        <span class="text-gold">Boutique</span>
      </nav>
      <div class="flex items-end justify-between gap-4">
        <h1 class="font-serif text-2xl sm:text-3xl font-semibold text-luxury-black">Boutique</h1>
        <span id="count-label" class="font-sans text-sm text-luxury-gray mb-0.5">{products.length} articles</span>
      </div>
    </div>
  </div>

  <!-- Sticky filter bar -->
  <div class="sticky top-20 lg:top-24 z-20 bg-white border-b border-cream-dark shadow-sm">
    <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-2 overflow-x-auto scrollbar-none py-3">
        {[{id:'all', name:'Tous'}, ...categories].map(cat => (
          <button
            class="filter-btn flex-shrink-0 font-sans text-[10px] sm:text-[11px] tracking-[0.15em] uppercase px-4 py-2 rounded-full border transition-all duration-200 whitespace-nowrap"
            data-filter={cat.id}
          >{cat.name}</button>
        ))}
      </div>
    </div>
  </div>

  <!-- Products -->
  <section class="px-4 sm:px-6 lg:px-8 pt-6 pb-16 bg-white">
    <div class="max-w-8xl mx-auto">
      <div id="products-grid" class="product-grid">
        {products.map(product => (
          <div class="product-item" data-category={product.category}>
            <ProductCard {...product} />
          </div>
        ))}
      </div>
      <div id="pagination" class="flex items-center justify-center gap-2 mt-10"></div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .filter-btn { background:#fff; color:#8B8B8B; border-color:#E8E0D5; }
  .filter-btn:hover { border-color:#D4AF37; color:#D4AF37; }
  .filter-btn.active { background:#D4AF37; color:#2C1810; border-color:#D4AF37; font-weight:700; }
  .scrollbar-none::-webkit-scrollbar { display:none; }
  .scrollbar-none { -ms-overflow-style:none; scrollbar-width:none; }
  .page-btn { width:38px; height:38px; display:flex; align-items:center; justify-content:center; border-radius:50%; font-family:sans-serif; font-size:13px; border:1px solid #E8E0D5; color:#6B6B6B; transition:all .2s; cursor:pointer; }
  .page-btn:hover { border-color:#D4AF37; color:#D4AF37; }
  .page-btn.active { background:#D4AF37; color:#2C1810; border-color:#D4AF37; font-weight:700; }
  .page-btn:disabled { opacity:.35; cursor:default; }
</style>

<script>
  const PER_PAGE = 12;
  let currentPage = 1;
  let activeFilter = 'all';

  const allItems   = Array.from(document.querySelectorAll('.product-item')) as HTMLElement[];
  const pagination = document.getElementById('pagination')!;
  const filterBtns = document.querySelectorAll('.filter-btn');
  const countLabel = document.getElementById('count-label')!;

  function getFiltered() {
    return activeFilter === 'all'
      ? allItems
      : allItems.filter(el => el.dataset.category === activeFilter);
  }

  function render() {
    const filtered   = getFiltered();
    const totalPages = Math.ceil(filtered.length / PER_PAGE);
    currentPage = Math.min(currentPage, totalPages || 1);
    const start = (currentPage - 1) * PER_PAGE;
    const end   = start + PER_PAGE;

    allItems.forEach(el => { el.style.display = 'none'; });
    filtered.slice(start, end).forEach(el => { el.style.display = ''; });

    if (countLabel) countLabel.textContent = `${filtered.length} article${filtered.length > 1 ? 's' : ''}`;

    pagination.innerHTML = '';
    if (totalPages <= 1) return;

    const prev = document.createElement('button');
    prev.className = 'page-btn';
    prev.innerHTML = '‹';
    prev.disabled = currentPage === 1;
    prev.onclick = () => { currentPage--; render(); window.scrollTo({top:0,behavior:'smooth'}); };
    pagination.appendChild(prev);

    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('button');
      btn.className = 'page-btn' + (i === currentPage ? ' active' : '');
      btn.textContent = String(i);
      btn.onclick = ((_i) => () => { currentPage = _i; render(); window.scrollTo({top:0,behavior:'smooth'}); })(i);
      pagination.appendChild(btn);
    }

    const next = document.createElement('button');
    next.className = 'page-btn';
    next.innerHTML = '›';
    next.disabled = currentPage === totalPages;
    next.onclick = () => { currentPage++; render(); window.scrollTo({top:0,behavior:'smooth'}); };
    pagination.appendChild(next);
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = (btn as HTMLElement).dataset.filter || 'all';
      currentPage = 1;
      render();
    });
  });

  document.querySelector('.filter-btn[data-filter="all"]')?.classList.add('active');
  render();
</script>
