---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Footer from '../../components/Footer.astro';
import { products, categories, formatPrice } from '../../data/products.js';
---
<Layout title="Boutique — Maison Khoudia">
  <!-- Hero Boutique -->
  <div class="relative overflow-hidden" style="min-height:55vh;">
    <img src="/products/p1.jpg" alt="Boutique Maison Khoudia" class="absolute inset-0 w-full h-full object-cover object-top" loading="eager" />
    <div class="absolute inset-0" style="background:linear-gradient(110deg,rgba(20,8,2,0.92) 0%,rgba(20,8,2,0.70) 45%,rgba(20,8,2,0.25) 75%);"></div>
    <div class="relative z-10 flex items-center min-h-[55vh] px-4 sm:px-14 lg:px-24">
      <div class="max-w-8xl mx-auto w-full">
        <nav class="breadcrumb mb-6">
          <a href="/" class="text-cream-light/50 hover:text-gold">Accueil</a><span class="text-gold/40">›</span><span class="text-gold">Boutique</span>
        </nav>
        <div class="max-w-xl">
          <p class="font-sans text-[11px] tracking-[0.28em] uppercase text-gold/70 mb-4">Nos Collections</p>
          <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-semibold text-cream-light leading-[0.95] mb-5">
            Toute la<br/><em class="text-gold not-italic">Boutique</em>
          </h1>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-10 h-px bg-gold"></div>
            <span class="text-gold/50 text-sm">◈</span>
          </div>
          <p class="font-sans text-cream-light/60 text-base leading-relaxed max-w-sm">
            Explorez toutes nos collections — mode femme, homme, enfants et accessoires de luxe.
          </p>
        </div>
      </div>
    </div>
  </div>
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-8xl mx-auto">
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        {categories.map(cat => (
          <a href={cat.href} class="group relative overflow-hidden block">
            {cat.image ? (
              <img src={cat.image} alt={cat.name} class="aspect-square w-full object-cover object-center transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class={`${cat.gradient} aspect-square w-full transition-transform duration-500 group-hover:scale-105`}></div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-brown/80 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <h3 class="font-serif text-xl font-bold text-cream-light">{cat.name}</h3>
              <p class="font-sans text-xs text-gold">{cat.count} articles</p>
            </div>
          </a>
        ))}
      </div>
      <h2 class="font-serif text-3xl font-bold text-luxury-black mb-8">Tous les Articles</h2>
      <div class="product-grid">
        {products.map(product => <ProductCard {...product} />)}
      </div>
    </div>
  </section>
  <Footer />
</Layout>
