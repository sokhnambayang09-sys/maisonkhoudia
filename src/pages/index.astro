---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CategorySection from '../components/CategorySection.astro';
import ProductCard from '../components/ProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import { products, formatPrice } from '../data/products.js';
const featuredProducts = products.slice(0, 4);
---
<Layout title="Maison Khoudia — Haute Mode & Élégance Africaine">
  <Hero />

  <!-- Engagements strip -->
  <div class="border-y border-cream-dark bg-cream-light">
    <div class="max-w-8xl mx-auto px-6 sm:px-10 lg:px-16">
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-x divide-cream-dark">
        {[
          { icon: "◈", label: "Tissus Premium",   desc: "Sélectionnés à la source" },
          { icon: "◈", label: "Artisanat Local",   desc: "Fait par nos artisans" },
          { icon: "◈", label: "Sur Mesure",        desc: "Chaque commande unique" },
          { icon: "◈", label: "Livraison Sûre",    desc: "Partout en Afrique" },
        ].map(e => (
          <div class="flex items-center gap-4 py-7 px-4 lg:px-8">
            <span class="text-gold text-xl flex-shrink-0">{e.icon}</span>
            <div>
              <div class="font-serif text-sm font-semibold text-luxury-black">{e.label}</div>
              <div class="font-sans text-[11px] text-luxury-gray mt-0.5">{e.desc}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <CategorySection title="Nos Collections" subtitle="Explorez notre univers" />

  <!-- Ticker -->
  <div class="bg-gold py-3 overflow-hidden">
    <div class="flex items-center gap-12 animate-[shimmerScroll_20s_linear_infinite]" style="width:max-content;">
      {Array(4).fill(null).map(() => (
        <>
          <span class="font-sans text-xs tracking-widest uppercase text-brown font-semibold whitespace-nowrap">✦ Nouvelle Collection 2025</span>
          <span class="font-sans text-xs tracking-widest uppercase text-brown/60 whitespace-nowrap">Livraison à partir de 2 000 FCFA</span>
          <span class="font-sans text-xs tracking-widest uppercase text-brown font-semibold whitespace-nowrap">✦ Abayas & Kaftans de Luxe</span>
          <span class="font-sans text-xs tracking-widest uppercase text-brown/60 whitespace-nowrap">Commandes Personnalisées</span>
        </>
      ))}
    </div>
  </div>

  <!-- Nouvelles Arrivées éditorial -->
  <section class="pt-24 pb-28 bg-white overflow-hidden" aria-labelledby="featured-heading">
    <div class="max-w-8xl mx-auto px-6 sm:px-10 lg:px-16">
      <div class="flex items-end justify-between mb-16 reveal">
        <div>
          <p class="font-sans text-[10px] tracking-[0.28em] uppercase text-gold mb-3">Sélection du moment</p>
          <h2 id="featured-heading" class="font-serif text-5xl sm:text-6xl lg:text-7xl font-semibold text-luxury-black leading-[0.95]">Nouvelles<br/>Arrivées</h2>
        </div>
        <a href="/boutique" class="hidden sm:flex items-center gap-2 font-sans text-xs tracking-[0.18em] uppercase text-luxury-black/50 hover:text-gold transition-colors pb-2 group">
          Voir tout
          <span class="w-8 h-px bg-luxury-black/30 group-hover:bg-gold group-hover:w-12 transition-all duration-300"></span>
        </a>
      </div>
      <div class="editorial-grid">
        {featuredProducts.map((product, index) => (
          <div class={`editorial-item reveal ${index % 2 === 1 ? 'editorial-offset' : ''}`} style={`animation-delay: ${index * 100}ms`}>
            <ProductCard {...product} tall={index % 2 === 1} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Commander par WhatsApp -->
  <section class="bg-brown py-24 px-4 sm:px-6 lg:px-16 overflow-hidden" aria-labelledby="wa-heading">
    <div class="max-w-8xl mx-auto">
      <div class="text-center mb-16 reveal">
        <p class="font-sans text-[11px] tracking-[0.28em] uppercase text-gold/70 mb-3">Simple & Rapide</p>
        <h2 id="wa-heading" class="font-serif text-5xl sm:text-6xl font-semibold text-cream-light leading-[0.95] mb-6">
          Commander<br/><em class="text-gold not-italic">par WhatsApp</em>
        </h2>
        <p class="font-sans text-cream-light/50 text-sm max-w-xs mx-auto leading-relaxed">Votre article de luxe en 3 étapes — livré directement chez vous.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 mb-16">
        {[
          { n:"01", title:"Choisissez",  desc:"Parcourez nos collections et sélectionnez l'article qui vous correspond." },
          { n:"02", title:"Contactez",   desc:'Cliquez sur "Commander" — un message WhatsApp prérempli s\'ouvre automatiquement.' },
          { n:"03", title:"Recevez",     desc:"Confirmez votre commande et recevez votre colis partout en Afrique." },
        ].map((s, i) => (
          <div class={`relative px-8 py-6 md:py-2 reveal ${i > 0 ? 'md:border-l border-cream-light/10' : ''}`} style={`animation-delay:${i*150}ms`}>
            <div class="font-serif text-[4.5rem] font-bold text-gold/12 leading-none mb-3 select-none">{s.n}</div>
            <div class="w-6 h-px bg-gold mb-4"></div>
            <h3 class="font-serif text-xl font-semibold text-cream-light mb-3">{s.title}</h3>
            <p class="font-sans text-sm text-cream-light/50 leading-relaxed max-w-[22ch]">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center reveal">
        <a href="https://wa.me/221785064773" target="_blank" rel="noopener" class="inline-flex items-center gap-3 px-10 py-5 bg-gold text-brown font-sans font-semibold text-sm tracking-widest uppercase hover:bg-gold-dark transition-colors duration-300">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.122.554 4.112 1.523 5.838L0 24l6.337-1.498A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.806 9.806 0 0 1-5.013-1.374l-.36-.213-3.73.881.937-3.613-.234-.37A9.818 9.818 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
          Nous Contacter sur WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Notre Histoire -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-white" aria-labelledby="about-teaser-heading">
    <div class="max-w-8xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="relative reveal">
          <img src="/fondatrice.png" alt="Fondatrice de Maison Khoudia" class="w-full object-cover object-top" style="aspect-ratio:3/4;" loading="lazy" />
          <div class="absolute -bottom-4 -right-4 bg-gold px-5 py-4 shadow-luxury-md">
            <div class="font-serif text-base font-bold text-brown leading-tight">CEO</div>
            <div class="font-sans text-[10px] text-brown/80 tracking-wider leading-tight mt-0.5">Maison Khoudia</div>
          </div>
        </div>
        <div class="reveal">
          <p class="section-subheading mb-4">Notre Histoire</p>
          <h2 id="about-teaser-heading" class="section-heading mb-6">L'Art de la Mode<br/><em class="text-gold not-italic">Africaine</em></h2>
          <div class="gold-divider-left mb-6"></div>
          <p class="font-sans text-luxury-gray text-base leading-relaxed mb-4">
            Fondée avec passion, Maison Khoudia est née d'un rêve simple : rendre la haute mode accessible tout en célébrant les richesses de la culture africaine.
          </p>
          <p class="font-sans text-luxury-gray text-base leading-relaxed mb-8">
            Chaque création raconte une histoire — celle d'une femme, d'un homme, d'une famille qui porte en lui l'élégance comme seconde nature.
          </p>
          <a href="/about" class="btn-secondary group">
            Découvrir Notre Histoire
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="py-24 px-4 sm:px-6 lg:px-8 bg-cream" aria-labelledby="testimonials-heading">
    <div class="max-w-8xl mx-auto">
      <div class="text-center mb-16 reveal">
        <p class="section-subheading mb-3">Avis Clients</p>
        <h2 id="testimonials-heading" class="section-heading">Elles Parlent de Nous</h2>
        <div class="gold-divider"></div>
      </div>

      <!-- Featured testimonial -->
      <div class="relative mb-12 reveal">
        <div class="font-serif text-[8rem] leading-none text-gold/15 absolute -top-6 left-0 select-none">&ldquo;</div>
        <div class="max-w-2xl mx-auto text-center relative z-10 pt-8">
          <p class="font-serif text-xl sm:text-2xl text-luxury-black leading-relaxed italic mb-8">
            "La qualité est exceptionnelle. Mon abaya est magnifique, les broderies sont d'une finesse rare. Je recommande vivement Maison Khoudia à toutes."
          </p>
          <div class="flex items-center justify-center gap-3">
            <div class="w-10 h-px bg-gold"></div>
            <div class="text-center">
              <div class="font-serif text-sm font-semibold text-luxury-black">Aissatou D.</div>
              <div class="font-sans text-xs text-luxury-gray">Dakar, Sénégal · Abaya Prestige</div>
            </div>
            <div class="w-10 h-px bg-gold"></div>
          </div>
        </div>
      </div>

      <!-- Secondary testimonials -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {[
          { name:"Mariama K.", location:"Abidjan, Côte d'Ivoire", text:"J'ai commandé une robe sur mesure pour mon mariage et le résultat était époustouflant. Tout le monde voulait savoir où je l'avais eu.", product:"Robe Élégance Dorée" },
          { name:"Fatoumata B.", location:"Bamako, Mali", text:"Le service client est impeccable. Livraison rapide, emballage soigné et la robe est encore plus belle qu'en photo.", product:"Kaftan Royal" },
        ].map((r, i) => (
          <div class="border-l-2 border-gold/30 pl-6 reveal" style={`animation-delay:${i*150}ms`}>
            <div class="flex gap-1 mb-3">{Array(5).fill(null).map(() => <span class="text-gold text-xs">★</span>)}</div>
            <p class="font-sans text-luxury-gray text-sm leading-relaxed mb-4 italic">&ldquo;{r.text}&rdquo;</p>
            <div class="font-serif text-sm font-semibold text-luxury-black">{r.name}</div>
            <div class="font-sans text-xs text-luxury-gray">{r.location}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Newsletter variant="dark" />
  <Footer />
</Layout>

<style>
  @keyframes shimmerScroll { from{transform:translateX(0)} to{transform:translateX(-25%)} }
  .editorial-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; align-items:start; }
  @media(min-width:768px){
    .editorial-grid { grid-template-columns:repeat(4,1fr); gap:2rem; }
    .editorial-offset { margin-top:5rem; }
  }
</style>
