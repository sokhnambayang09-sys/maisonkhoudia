---
interface Props { ctaHref?: string; }
const { ctaHref = "/boutique" } = Astro.props;
---

<section class="hero relative h-[72vh] sm:h-[82vh] min-h-[500px] max-h-[820px] overflow-hidden bg-brown" aria-label="Hero — Maison Khoudia">

  <!-- Background avec parallax + Ken Burns -->
  <div class="hero-bg-wrap absolute inset-[-8%] will-change-transform">
    <img
      src="/hero-campaign.png"
      alt="Maison Khoudia"
      class="w-full h-full object-cover object-center"
      style="animation: kenBurns 20s ease-in-out infinite alternate; transform-origin: center;"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- Grain texture luxe -->
  <div class="absolute inset-0 z-[1] pointer-events-none opacity-[0.04]"
    style="background-image:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.75%22 numOctaves=%224%22 stitchTiles=%22stitch%22/></filter><rect width=%22200%22 height=%22200%22 filter=%22url(%23n)%22 opacity=%221%22/></svg>');
    mix-blend-mode: overlay;">
  </div>

  <!-- Dégradés -->
  <div class="absolute inset-0 z-[2]"
    style="background: linear-gradient(110deg, rgba(20,8,2,0.90) 0%, rgba(20,8,2,0.70) 32%, rgba(20,8,2,0.22) 58%, rgba(20,8,2,0.04) 75%);">
  </div>
  <div class="absolute inset-0 z-[2]"
    style="background: linear-gradient(to top, rgba(20,8,2,0.70) 0%, rgba(20,8,2,0.15) 30%, transparent 55%);">
  </div>

  <!-- Rideaux d'ouverture -->
  <div class="curtain curtain-top absolute top-0 left-0 right-0 z-40 bg-brown will-change-transform" style="height:52%;"></div>
  <div class="curtain curtain-bot absolute bottom-0 left-0 right-0 z-40 bg-brown will-change-transform" style="height:52%;"></div>

  <!-- Particules dorées flottantes -->
  <div class="absolute inset-0 z-[3] pointer-events-none overflow-hidden">
    {[
      { x:12, y:25, s:3, d:0    },
      { x:85, y:15, s:2, d:1.2  },
      { x:70, y:60, s:4, d:0.5  },
      { x:20, y:72, s:2, d:1.8  },
      { x:55, y:85, s:3, d:0.9  },
      { x:92, y:45, s:2, d:2.1  },
    ].map(p => (
      <div
        class="particle absolute rounded-full bg-gold opacity-0"
        style={`width:${p.s}px;height:${p.s}px;left:${p.x}%;top:${p.y}%;animation:particleFloat ${4 + p.d}s ease-in-out ${3 + p.d}s infinite;`}
      ></div>
    ))}
  </div>

  <!-- Ligne décorative gauche -->
  <div class="absolute left-6 sm:left-8 lg:left-14 top-0 bottom-0 z-10 hidden sm:flex flex-col items-center justify-center gap-4 hero-sideline opacity-0">
    <div class="w-px h-16 bg-gradient-to-b from-transparent to-gold/40"></div>
    <span class="font-sans text-[7px] tracking-[0.4em] uppercase text-gold/40" style="writing-mode:vertical-rl;letter-spacing:0.4em;">Maison Khoudia</span>
    <div class="w-px h-16 bg-gradient-to-t from-transparent to-gold/40"></div>
  </div>

  <!-- Contenu principal -->
  <div class="relative z-10 h-full flex items-center">
    <div class="max-w-8xl mx-auto px-5 sm:px-14 lg:px-24 w-full">
      <div class="max-w-[680px]">

        <!-- Label -->
        <div class="hidden sm:block overflow-hidden mb-3 sm:mb-7">
          <div class="hero-line flex items-center gap-3 translate-y-full">
            <div class="hero-bar w-0 h-px bg-gold/50 transition-all duration-700"></div>
            <span class="font-sans text-[10px] tracking-[0.4em] uppercase text-gold/60">Collection Automne 2025</span>
          </div>
        </div>

        <!-- Titre — chaque ligne dans overflow-hidden pour l'effet "montée" -->
        <h1 class="mb-3 sm:mb-8" style="line-height:0.95;">

          <div class="overflow-hidden">
            <div class="hero-line translate-y-full">
              <span class="block font-serif font-light text-[clamp(2rem,5vw,4.5rem)] text-cream-light/85 tracking-tight">
                L'élégance
              </span>
            </div>
          </div>

          <div class="overflow-hidden">
            <div class="hero-line translate-y-full">
              <span class="block font-serif font-bold text-[clamp(2.4rem,7vw,6.5rem)] text-cream-light tracking-tight whitespace-nowrap">
                au rendez-vous
              </span>
            </div>
          </div>

          <div class="overflow-hidden">
            <div class="hero-line translate-y-full flex items-center gap-2 sm:gap-4">
              <span class="font-serif font-light italic text-[clamp(1.1rem,3.2vw,2.8rem)] text-gold/90 tracking-tight leading-none whitespace-nowrap">— avec Maison Khoudia</span>
              <div class="h-px bg-gold flex-1"></div>
              <span class="text-gold/50 text-xs sm:text-sm flex-shrink-0">◈</span>
            </div>
          </div>

        </h1>

        <!-- Divider animé supprimé, fusionné avec la ligne titre -->

        <!-- Description -->
        <div class="overflow-hidden mb-5 sm:mb-10">
          <div class="hero-line translate-y-full">
            <p class="font-sans text-[0.9rem] text-cream-light/55 leading-[1.85] max-w-full sm:max-w-[38ch]">
              Le chic au quotidien avec Maison Khoudia.
            </p>
          </div>
        </div>

        <!-- Boutons -->
        <div class="overflow-hidden">
          <div class="hero-line translate-y-full flex flex-wrap items-center gap-5">
            <a href={ctaHref}
              class="group relative inline-flex items-center gap-3 px-6 py-3.5 sm:px-9 sm:py-4 bg-gold text-brown font-sans font-semibold text-[10px] sm:text-[11px] tracking-[0.18em] sm:tracking-[0.25em] uppercase rounded-full overflow-hidden hover:-translate-y-0.5 hover:shadow-luxury-md transition-all duration-300">
              <span class="relative z-10">Découvrir la Collection</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="relative z-10 transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              <div class="absolute inset-0 bg-gold-light transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-out"></div>
            </a>
            <a href="#collections"
              class="inline-flex items-center gap-2 font-sans text-[10px] tracking-[0.25em] uppercase text-cream-light/45 hover:text-gold transition-colors duration-300 group">
              Nos Collections
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Barre stats bas -->
  <div class="hero-stats hidden sm:block absolute bottom-0 left-0 right-0 z-10 opacity-0 translate-y-4" style="transition:opacity 0.9s ease, transform 0.9s cubic-bezier(0.16,1,0.3,1);">
    <div class="max-w-8xl mx-auto px-5 sm:px-14 lg:px-24">
      <div class="border-t border-cream-light/[0.08] py-4 sm:py-5 grid grid-cols-2 sm:flex sm:items-center gap-y-3 gap-x-4 sm:gap-16">
        {[
          { n:"500+",  l:"Clients" },
          { n:"2000",  l:"FCFA livraison" },
          { n:"100%",  l:"Fait en Afrique" },
          { n:"Sur mesure", l:"Disponible" },
        ].map(s => (
          <div class="flex items-center gap-2 sm:gap-3">
            <div class="w-px h-5 sm:h-6 bg-gold/25 flex-shrink-0"></div>
            <div>
              <div class="font-serif text-sm sm:text-base font-semibold text-gold leading-none">{s.n}</div>
              <div class="font-sans text-[7px] sm:text-[8px] tracking-[0.18em] sm:tracking-[0.22em] uppercase text-cream-light/35 mt-0.5">{s.l}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Indicateur de scroll -->
  <div class="hero-scroll-cue absolute right-8 bottom-20 z-10 opacity-0 hidden sm:flex flex-col items-center gap-2">
    <div class="scroll-dot w-1 h-1 rounded-full bg-gold/60"></div>
    <div class="w-px h-10 bg-gradient-to-b from-gold/50 to-transparent"></div>
  </div>

</section>

<style>
  @keyframes kenBurns     { from{transform:scale(1.08)} to{transform:scale(1)} }
  @keyframes particleFloat{
    0%,100% { opacity:0; transform:translateY(0) scale(1); }
    20%     { opacity:0.6; }
    50%     { opacity:0.3; transform:translateY(-30px) scale(1.5); }
    80%     { opacity:0.6; }
  }
  @keyframes scrollDot {
    0%,100% { transform:translateY(0); opacity:0.6; }
    50%     { transform:translateY(8px); opacity:0.2; }
  }
  .scrollbar-none::-webkit-scrollbar { display:none; }
  .scrollbar-none { -ms-overflow-style:none; scrollbar-width:none; }
  .scroll-dot { animation: scrollDot 2s ease-in-out infinite; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const spring = 'cubic-bezier(0.16, 1, 0.3, 1)';

    // ── 1. Rideaux s'ouvrent ──────────────────────────────
    const curtainTop = document.querySelector('.curtain-top') as HTMLElement;
    const curtainBot = document.querySelector('.curtain-bot') as HTMLElement;
    [curtainTop, curtainBot].forEach(c => {
      if (!c) return;
      c.style.transition = `transform 1.2s ${spring}`;
    });
    setTimeout(() => {
      if (curtainTop) curtainTop.style.transform = 'translateY(-100%)';
      if (curtainBot) curtainBot.style.transform = 'translateY(100%)';
    }, 120);

    // ── 2. Lignes de texte montent (overflow-hidden reveal) ─
    const lines = document.querySelectorAll('.hero-line');
    lines.forEach((el, i) => {
      const e = el as HTMLElement;
      const delay = 1.1 + i * 0.16;
      e.style.transition = `transform 1s ${spring} ${delay}s`;
      setTimeout(() => { e.style.transform = 'translateY(0)'; }, delay * 1000);
    });

    // ── 3. Barre dorée grandit ───────────────────────────
    const bar = document.querySelector('.hero-bar') as HTMLElement;
    setTimeout(() => { if (bar) { bar.style.width = '32px'; } }, 1250);

    // ── 4. Éléments secondaires ──────────────────────────
    const sideline = document.querySelector('.hero-sideline') as HTMLElement;
    const stats    = document.querySelector('.hero-stats')    as HTMLElement;
    const scrollCue= document.querySelector('.hero-scroll-cue') as HTMLElement;

    setTimeout(() => {
      if (sideline) { sideline.style.transition = 'opacity 1.2s ease'; sideline.style.opacity = '1'; }
    }, 2300);
    setTimeout(() => {
      if (stats) { stats.style.opacity = '1'; stats.style.transform = 'translateY(0)'; }
    }, 2100);
    setTimeout(() => {
      if (scrollCue) { scrollCue.style.transition = 'opacity 1s ease'; scrollCue.style.opacity = '1'; }
    }, 2800);

    // ── 5. Parallax sur scroll ───────────────────────────
    const bgWrap = document.querySelector('.hero-bg-wrap') as HTMLElement;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (bgWrap) bgWrap.style.transform = `translateY(${y * 0.3}px)`;
    }, { passive: true });

    // ── 6. Parallax souris (subtil) ──────────────────────
    document.addEventListener('mousemove', (e: MouseEvent) => {
      if (!bgWrap) return;
      const mx = (e.clientX / window.innerWidth  - 0.5) * 18;
      const my = (e.clientY / window.innerHeight - 0.5) * 10;
      bgWrap.style.transform = `translate(${mx}px, ${my}px)`;
    });
  });
</script>
