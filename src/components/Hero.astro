---
interface Props { ctaHref?: string; }
const { ctaHref = "/boutique" } = Astro.props;
---
<section class="relative h-screen min-h-[580px] max-h-[960px] overflow-hidden" aria-label="Hero — Maison Khoudia">
  <img src="/hero-campaign.png" alt="Maison Khoudia — Collection" class="absolute inset-0 w-full h-full object-cover object-center" loading="eager" decoding="async" />
  <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(250,244,234,0.82) 0%, rgba(250,244,234,0.60) 38%, rgba(250,244,234,0.15) 58%, transparent 72%);"></div>
  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,12,5,0.28) 0%, transparent 30%);"></div>
  <div class="relative z-10 h-full flex items-center">
    <div class="max-w-8xl mx-auto px-6 sm:px-10 lg:px-16 w-full">
      <div class="max-w-[480px] lg:max-w-[580px]">
        <p class="font-sans text-[11px] tracking-[0.22em] text-brown/55 mb-5 uppercase">Collection Automne 2025</p>
        <h1 class="font-serif text-[3.2rem] sm:text-[4rem] lg:text-[5rem] xl:text-[5.5rem] font-semibold text-luxury-black leading-[1.04] mb-5 whitespace-nowrap">
          L'élégance<br/>à l'état pur
        </h1>
        <div class="w-10 h-px bg-gold mb-5"></div>
        <p class="font-sans text-[0.88rem] text-luxury-black/58 leading-[1.7] mb-9 max-w-[30ch]">
          Des créations qui allient l'art de la mode africaine à l'élégance contemporaine.
        </p>
        <a href={ctaHref} class="btn-primary">Découvrir la collection</a>
      </div>
    </div>
  </div>
  <div class="absolute bottom-8 left-6 sm:left-10 lg:left-16 z-10">
    <div class="w-px h-12 bg-luxury-black/18" style="animation: fadeDown 2s ease-in-out infinite;"></div>
  </div>
</section>
<style>
  @keyframes fadeDown { 0%,100%{opacity:.3} 50%{opacity:.8} }
</style>
