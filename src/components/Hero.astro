---
interface Props { ctaHref?: string; }
const { ctaHref = "/boutique" } = Astro.props;
---

<section class="hero-wrap relative h-screen min-h-[620px] overflow-hidden" aria-label="Hero — Maison Khoudia">

  <!-- Background image with Ken Burns -->
  <img
    src="/hero-campaign.png"
    alt="Maison Khoudia — Collection"
    class="hero-bg absolute inset-0 w-full h-full object-cover object-center"
    style="animation: kenBurns 16s ease-in-out infinite alternate;"
    loading="eager"
    decoding="async"
  />

  <!-- Deep vignette overlays -->
  <div class="absolute inset-0" style="background: linear-gradient(105deg, rgba(26,10,4,0.88) 0%, rgba(26,10,4,0.65) 35%, rgba(26,10,4,0.25) 58%, rgba(26,10,4,0.05) 75%);"></div>
  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(26,10,4,0.6) 0%, transparent 40%);"></div>
  <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(26,10,4,0.3) 0%, transparent 20%);"></div>

  <!-- Curtain (reveals on load) -->
  <div class="hero-curtain absolute inset-0 bg-brown z-20 pointer-events-none"></div>

  <!-- Gold decorative side line -->
  <div class="hero-sideline absolute left-6 sm:left-10 lg:left-16 top-1/2 -translate-y-1/2 z-10 flex flex-col items-center gap-3 opacity-0">
    <span class="font-sans text-[8px] tracking-[0.35em] uppercase text-gold/50" style="writing-mode:vertical-rl;">Maison Khoudia</span>
    <div class="w-px h-20 bg-gradient-to-b from-transparent via-gold/40 to-transparent"></div>
  </div>

  <!-- Main content -->
  <div class="relative z-10 h-full flex items-center">
    <div class="max-w-8xl mx-auto px-6 sm:px-10 lg:px-20 w-full">
      <div class="max-w-[640px]">

        <!-- Label -->
        <div class="hero-el opacity-0 flex items-center gap-3 mb-8">
          <div class="w-8 h-px bg-gold/60"></div>
          <span class="font-sans text-[10px] tracking-[0.35em] uppercase text-gold/70">Collection Automne 2025</span>
        </div>

        <!-- Headline -->
        <h1 class="mb-8 leading-[0.92]">
          <span class="hero-el opacity-0 block font-serif text-[2.6rem] sm:text-[3.4rem] lg:text-[4.4rem] xl:text-[5rem] font-light text-cream-light/90 tracking-tight">
            Porter l'Afrique
          </span>
          <span class="hero-el opacity-0 block font-serif text-[3.4rem] sm:text-[4.4rem] lg:text-[5.6rem] xl:text-[6.4rem] font-bold text-cream-light tracking-tight mt-1">
            avec fierté
          </span>
          <span class="hero-el opacity-0 block font-serif text-[2rem] sm:text-[2.6rem] lg:text-[3.2rem] xl:text-[3.6rem] font-light italic text-gold mt-3">
            et élégance
          </span>
        </h1>

        <!-- Divider -->
        <div class="hero-el opacity-0 flex items-center gap-4 mb-7">
          <div class="hero-line-bar h-px bg-gold" style="width:0"></div>
          <span class="text-gold/60 text-sm">◈</span>
          <div class="h-px bg-gold/30 w-16"></div>
        </div>

        <!-- Description -->
        <p class="hero-el opacity-0 font-sans text-[0.92rem] text-cream-light/60 leading-[1.8] mb-10 max-w-[36ch]">
          Maison Khoudia habille chaque moment de vie avec des créations qui célèbrent la richesse de notre culture.
        </p>

        <!-- CTAs -->
        <div class="hero-el opacity-0 flex flex-wrap items-center gap-5">
          <a href={ctaHref} class="group inline-flex items-center gap-3 px-9 py-4 bg-gold text-brown font-sans font-semibold text-sm tracking-widest uppercase hover:bg-gold-dark transition-all duration-300 hover:-translate-y-0.5 hover:shadow-luxury-md">
            Découvrir la Collection
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#collections" class="inline-flex items-center gap-2 font-sans text-xs tracking-[0.2em] uppercase text-cream-light/50 hover:text-gold transition-colors duration-300">
            Nos Collections
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom stats bar -->
  <div class="hero-stats absolute bottom-0 left-0 right-0 z-10 opacity-0">
    <div class="max-w-8xl mx-auto px-6 sm:px-10 lg:px-20">
      <div class="border-t border-cream-light/10 py-6 flex items-center gap-10 sm:gap-16 overflow-x-auto scrollbar-none">
        {[
          { n: "500+", l: "Clients satisfaits" },
          { n: "4",    l: "Collections" },
          { n: "2000", l: "FCFA livraison" },
          { n: "100%", l: "Fait en Afrique" },
        ].map(s => (
          <div class="flex-shrink-0 text-center">
            <div class="font-serif text-xl font-bold text-gold leading-none">{s.n}</div>
            <div class="font-sans text-[9px] tracking-[0.2em] uppercase text-cream-light/40 mt-1">{s.l}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="hero-scroll absolute right-8 bottom-24 z-10 opacity-0 flex flex-col items-center gap-2 hidden sm:flex">
    <div class="w-px h-12 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-gold/60 to-transparent" style="animation:floatUp 2s ease-in-out infinite;"></div>
    </div>
  </div>

</section>

<style>
  @keyframes kenBurns { from{transform:scale(1)} to{transform:scale(1.08)} }
  @keyframes floatUp { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
  .scrollbar-none::-webkit-scrollbar { display:none; }
  .scrollbar-none { -ms-overflow-style:none; scrollbar-width:none; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const curtain  = document.querySelector('.hero-curtain') as HTMLElement;
    const els      = document.querySelectorAll('.hero-el');
    const sideline = document.querySelector('.hero-sideline') as HTMLElement;
    const stats    = document.querySelector('.hero-stats') as HTMLElement;
    const scroll   = document.querySelector('.hero-scroll') as HTMLElement;
    const lineBar  = document.querySelector('.hero-line-bar') as HTMLElement;

    // 1. Curtain slides up
    if (curtain) {
      setTimeout(() => {
        curtain.style.transition = 'transform 1.1s cubic-bezier(0.76, 0, 0.24, 1)';
        curtain.style.transform = 'translateY(-100%)';
      }, 100);
    }

    // 2. Text elements stagger in
    const spring = 'cubic-bezier(0.16, 1, 0.3, 1)';
    els.forEach((el, i) => {
      const e = el as HTMLElement;
      e.style.transform = 'translateY(24px)';
      const delay = 1.0 + i * 0.14;
      e.style.transition = `opacity 0.9s ${spring} ${delay}s, transform 0.9s ${spring} ${delay}s`;
      setTimeout(() => { e.style.opacity = '1'; e.style.transform = 'translateY(0)'; }, delay * 1000);
    });

    // 3. Gold line grows
    if (lineBar) {
      setTimeout(() => {
        lineBar.style.transition = 'width 0.7s cubic-bezier(0.16,1,0.3,1)';
        lineBar.style.width = '48px';
      }, 1700);
    }

    // 4. Side decoration
    if (sideline) {
      setTimeout(() => {
        sideline.style.transition = 'opacity 1.2s ease';
        sideline.style.opacity = '1';
      }, 2200);
    }

    // 5. Stats bar
    if (stats) {
      setTimeout(() => {
        stats.style.transition = 'opacity 1s ease, transform 0.8s cubic-bezier(0.16,1,0.3,1)';
        stats.style.transform = 'translateY(0)';
        stats.style.opacity = '1';
      }, 2000);
      stats.style.transform = 'translateY(20px)';
    }

    // 6. Scroll cue
    if (scroll) {
      setTimeout(() => {
        scroll.style.transition = 'opacity 1s ease';
        scroll.style.opacity = '1';
      }, 2600);
    }
  });
</script>
