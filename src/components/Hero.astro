---
interface Props { ctaHref?: string; }
const { ctaHref = "/boutique" } = Astro.props;
---
<section class="hero-wrap relative h-screen min-h-[600px] max-h-[980px] overflow-hidden" aria-label="Hero — Maison Khoudia">

  <!-- Ken Burns background -->
  <img
    src="/hero-campaign.png"
    alt="Maison Khoudia — Collection"
    class="absolute inset-0 w-full h-full object-cover object-center"
    style="animation: kenBurns 14s ease-in-out infinite alternate;"
    loading="eager"
    decoding="async"
  />

  <!-- Gradients -->
  <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(44,24,16,0.72) 0%, rgba(44,24,16,0.45) 40%, rgba(44,24,16,0.1) 65%, transparent 80%);"></div>
  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(20,12,5,0.4) 0%, transparent 35%);"></div>

  <!-- Curtain (brown overlay that slides up) -->
  <div class="hero-curtain absolute inset-0 bg-brown z-20 pointer-events-none"></div>

  <!-- Content -->
  <div class="relative z-10 h-full flex items-center">
    <div class="max-w-8xl mx-auto px-6 sm:px-10 lg:px-16 w-full">
      <div class="max-w-[520px] lg:max-w-[600px]">

        <p class="hero-line font-sans text-[11px] tracking-[0.28em] text-cream-light/60 mb-6 uppercase opacity-0">
          Collection Automne 2025
        </p>

        <h1 class="font-serif leading-[1.02] mb-6">
          <span class="hero-line block text-[3.4rem] sm:text-[4.2rem] lg:text-[5.2rem] xl:text-[5.8rem] font-semibold text-cream-light opacity-0 whitespace-nowrap">
            L'élégance
          </span>
          <span class="hero-line block text-[3.4rem] sm:text-[4.2rem] lg:text-[5.2rem] xl:text-[5.8rem] font-semibold text-gold opacity-0 whitespace-nowrap italic">
            à l'état pur
          </span>
        </h1>

        <div class="hero-line opacity-0 overflow-hidden mb-6">
          <div class="w-12 h-px bg-gold hero-line-bar"></div>
        </div>

        <p class="hero-line font-sans text-[0.9rem] text-cream-light/65 leading-[1.75] mb-10 max-w-[32ch] opacity-0">
          Des créations qui allient l'art de la mode africaine à l'élégance contemporaine.
        </p>

        <div class="hero-line opacity-0 flex items-center gap-5">
          <a href={ctaHref} class="btn-primary">Découvrir la collection</a>
          <a href="#collections" class="font-sans text-xs tracking-[0.2em] uppercase text-cream-light/50 hover:text-gold transition-colors flex items-center gap-2">
            Nos Collections
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 right-8 z-10 hero-scroll opacity-0 flex flex-col items-center gap-2">
    <span class="font-sans text-[9px] tracking-[0.25em] uppercase text-cream-light/40 writing-vertical">Défiler</span>
    <div class="w-px h-14 bg-gradient-to-b from-transparent via-cream-light/30 to-transparent" style="animation: floatUp 2s ease-in-out infinite;"></div>
  </div>

</section>

<script>
  // Curtain open + staggered text entrance
  document.addEventListener('DOMContentLoaded', () => {
    const curtain = document.querySelector('.hero-curtain') as HTMLElement;
    const lines   = document.querySelectorAll('.hero-line');
    const scroll  = document.querySelector('.hero-scroll') as HTMLElement;

    // 1. Curtain slides up
    if (curtain) {
      curtain.style.transition = 'transform 1s cubic-bezier(0.76, 0, 0.24, 1)';
      curtain.style.transformOrigin = 'top';
      setTimeout(() => { curtain.style.transform = 'translateY(-100%)'; }, 150);
    }

    // 2. Text lines stagger in
    lines.forEach((el, i) => {
      const e = el as HTMLElement;
      e.style.transition = `opacity 0.75s cubic-bezier(0.16,1,0.3,1) ${1.1 + i * 0.15}s, transform 0.75s cubic-bezier(0.16,1,0.3,1) ${1.1 + i * 0.15}s`;
      e.style.transform = 'translateY(20px)';
      setTimeout(() => {
        e.style.opacity = '1';
        e.style.transform = 'translateY(0)';
      }, (1.1 + i * 0.15) * 1000);
    });

    // 3. Gold line grows
    const bar = document.querySelector('.hero-line-bar') as HTMLElement;
    if (bar) {
      bar.style.transform = 'scaleX(0)';
      bar.style.transformOrigin = 'left';
      setTimeout(() => {
        bar.style.transition = 'transform 0.6s cubic-bezier(0.16,1,0.3,1)';
        bar.style.transform = 'scaleX(1)';
      }, 1600);
    }

    // 4. Scroll indicator
    if (scroll) {
      setTimeout(() => {
        scroll.style.transition = 'opacity 1s ease';
        scroll.style.opacity = '1';
      }, 2400);
    }
  });
</script>
