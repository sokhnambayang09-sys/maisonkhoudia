---
interface Props { variant?: 'light' | 'dark'; }
const { variant = 'light' } = Astro.props;
const isDark = variant === 'dark';
---
<section class={`relative overflow-hidden py-24 px-4 sm:px-6 lg:px-8 ${isDark ? 'bg-brown' : 'bg-cream'}`}>
  {isDark && (
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 10% 50%, #D4AF37 0%, transparent 50%), radial-gradient(circle at 90% 50%, #D4AF37 0%, transparent 50%);"></div>
  )}
  <div class="relative z-10 max-w-2xl mx-auto text-center reveal">
    <div class="text-gold text-3xl mb-5">◈</div>
    <p class={`section-subheading mb-3 ${isDark ? 'text-gold' : ''}`}>Restez Informée</p>
    <h2 class={`font-serif text-4xl sm:text-5xl font-semibold mb-4 leading-[1.05] ${isDark ? 'text-cream-light' : 'text-luxury-black'}`}>
      L'Élégance dans<br/>Votre Boîte Mail
    </h2>
    <div class="gold-divider"></div>
    <p class={`font-sans text-sm leading-relaxed mt-5 mb-10 max-w-sm mx-auto ${isDark ? 'text-cream-light/55' : 'text-luxury-gray'}`}>
      Nouvelles collections, offres exclusives et événements privés — soyez la première informée.
    </p>
    <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); window.showToast?.('Merci ! Vous êtes inscrite.')">
      <input
        type="email"
        placeholder="Votre adresse email"
        required
        class={`flex-1 px-5 py-4 font-sans text-sm border focus:outline-none focus:border-gold transition-colors duration-200 ${isDark ? 'bg-white/8 border-cream-light/15 text-cream-light placeholder-cream-light/35 focus:bg-white/12' : 'bg-white border-cream-dark text-luxury-black'}`}
      />
      <button type="submit" class="btn-primary whitespace-nowrap">S'inscrire</button>
    </form>
  </div>
</section>
