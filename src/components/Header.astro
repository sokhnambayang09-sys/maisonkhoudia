---
const navLinks = [
  { label: "Accueil", href: "/" },
  { label: "Boutique", href: "/boutique", dropdown: [
    { label: "Femme",       href: "/boutique/femme",       desc: "Robes, Abayas, Kaftans" },
    { label: "Homme",       href: "/boutique/homme",       desc: "Costumes, Chemises" },
    { label: "Enfants",     href: "/boutique/enfants",     desc: "Fille & Garçon" },
    { label: "Accessoires", href: "/boutique/accessoires", desc: "Sacs, Chaussures, Bijoux" },
  ]},
  { label: "À Propos", href: "/about" },
  { label: "Contact",  href: "/contact" },
];
const currentPath = Astro.url.pathname;
---

<div class="bg-brown text-cream-light text-center py-2 px-4 text-xs font-sans tracking-widest uppercase">
  ✦ Livraison disponible à partir de 2 000 FCFA ✦ Nouvelle collection disponible ✦
</div>

<header id="main-header" class="sticky top-0 z-30 bg-cream-light/95 backdrop-blur-sm border-b border-cream-dark transition-all duration-300" role="banner">
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-22 md:h-24">

      <button id="hamburger-btn" class="hamburger lg:hidden flex flex-col gap-1.5 p-2 -ml-2 z-50" aria-label="Ouvrir le menu" aria-expanded="false" onclick="toggleMobileMenu()">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <a href="/" class="flex-shrink-0 group" aria-label="Maison Khoudia — Accueil">
        <img src="/logo.png" alt="Maison Khoudia" class="h-20 w-auto object-contain transition-opacity duration-300 group-hover:opacity-80" loading="eager" />
      </a>

      <nav class="hidden lg:flex items-center gap-8" role="navigation">
        {navLinks.map(link => (
          link.dropdown ? (
            <div class="dropdown-trigger relative group">
              <a href={link.href} class={`nav-link py-2 flex items-center gap-1 ${currentPath.startsWith('/boutique') ? 'text-gold' : ''}`}>
                {link.label}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
              </a>
              <div class="dropdown-menu">
                <div class="py-2">
                  {link.dropdown.map(item => (
                    <a href={item.href} class={`flex flex-col px-5 py-3 hover:bg-cream transition-colors duration-200 ${currentPath === item.href ? 'border-l-2 border-gold bg-cream' : ''}`}>
                      <span class="font-sans text-sm font-medium text-luxury-black">{item.label}</span>
                      <span class="font-sans text-xs text-luxury-gray mt-0.5">{item.desc}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={link.href} class={`nav-link py-2 ${currentPath === link.href ? 'text-gold' : ''}`}>{link.label}</a>
          )
        ))}
      </nav>

      <div class="flex items-center gap-1 sm:gap-2">
        <button class="w-10 h-10 flex items-center justify-center text-luxury-black hover:text-gold transition-colors duration-200" aria-label="Rechercher">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
        <button class="hidden sm:flex w-10 h-10 items-center justify-center text-luxury-black hover:text-gold transition-colors duration-200" aria-label="Favoris">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        <button class="relative w-10 h-10 flex items-center justify-center text-luxury-black hover:text-gold transition-colors duration-200" aria-label="Panier">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div id="mobile-overlay" class="fixed inset-0 bg-luxury-black/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden" onclick="closeMobileMenu()"></div>

<nav id="mobile-menu" class="mobile-menu lg:hidden" role="navigation" aria-hidden="true">
  <div class="flex items-center justify-between p-6 border-b border-cream-dark">
    <img src="/logo.png" alt="Maison Khoudia" class="h-16 w-auto object-contain" />
    <button onclick="closeMobileMenu()" class="w-10 h-10 flex items-center justify-center text-luxury-gray hover:text-gold transition-colors" aria-label="Fermer">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto py-4">
    <div class="px-6 space-y-1">
      <a href="/" class="flex items-center py-4 border-b border-cream-dark font-serif text-lg text-luxury-black hover:text-gold transition-colors" onclick="closeMobileMenu()">Accueil</a>
      <div class="border-b border-cream-dark">
        <button id="boutique-toggle" class="flex items-center justify-between w-full py-4 font-serif text-lg text-luxury-black hover:text-gold transition-colors" onclick="toggleBoutiqueMenu()" aria-expanded="false">
          Boutique
          <svg id="boutique-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="boutique-submenu" class="hidden pb-4 space-y-1">
          {[
            { label: "Toutes les Collections", href: "/boutique" },
            { label: "Femme",       href: "/boutique/femme" },
            { label: "Homme",       href: "/boutique/homme" },
            { label: "Enfants",     href: "/boutique/enfants" },
            { label: "Accessoires", href: "/boutique/accessoires" },
          ].map(item => (
            <a href={item.href} class="flex items-center px-4 py-3 text-sm font-sans text-luxury-gray hover:text-gold hover:bg-cream rounded transition-all" onclick="closeMobileMenu()">{item.label}</a>
          ))}
        </div>
      </div>
      <a href="/about"   class="flex items-center py-4 border-b border-cream-dark font-serif text-lg text-luxury-black hover:text-gold transition-colors" onclick="closeMobileMenu()">À Propos</a>
      <a href="/contact" class="flex items-center py-4 font-serif text-lg text-luxury-black hover:text-gold transition-colors" onclick="closeMobileMenu()">Contact</a>
    </div>
    <div class="px-6 mt-8 space-y-3">
      <a href="/boutique" class="btn-primary w-full justify-center" onclick="closeMobileMenu()">Découvrir la Boutique</a>
    </div>
  </div>
</nav>

<script>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-overlay');
    const btn = document.getElementById('hamburger-btn');
    if (menu?.classList.contains('open')) { closeMobileMenu(); return; }
    menu?.classList.add('open');
    overlay?.classList.remove('opacity-0','pointer-events-none');
    btn?.classList.add('open'); btn?.setAttribute('aria-expanded','true');
    menu?.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  }
  function closeMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-overlay');
    const btn = document.getElementById('hamburger-btn');
    menu?.classList.remove('open');
    overlay?.classList.add('opacity-0','pointer-events-none');
    btn?.classList.remove('open'); btn?.setAttribute('aria-expanded','false');
    menu?.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
  }
  function toggleBoutiqueMenu() {
    const sub = document.getElementById('boutique-submenu');
    const arrow = document.getElementById('boutique-arrow');
    const btn = document.getElementById('boutique-toggle');
    const isOpen = !sub?.classList.contains('hidden');
    sub?.classList.toggle('hidden', isOpen);
    arrow?.classList.toggle('rotate-180', !isOpen);
    btn?.setAttribute('aria-expanded', String(!isOpen));
  }
  window.addEventListener('scroll', () => {
    const h = document.getElementById('main-header');
    if (h) h.classList.toggle('shadow-card', window.scrollY > 50);
  });
  window.toggleMobileMenu = toggleMobileMenu;
  window.closeMobileMenu = closeMobileMenu;
  window.toggleBoutiqueMenu = toggleBoutiqueMenu;
</script>
