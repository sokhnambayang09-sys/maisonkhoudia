---
const navLinks = [
  { label: "Accueil",   href: "/" },
  { label: "Boutique",  href: "/boutique", dropdown: [
    { label: "Femme",       href: "/boutique/femme",       desc: "Robes, Abayas, Kaftans" },
    { label: "Homme",       href: "/boutique/homme",       desc: "Costumes, Chemises" },
    { label: "Enfants",     href: "/boutique/enfants",     desc: "Fille & Garçon" },
    { label: "Accessoires", href: "/boutique/accessoires", desc: "Sacs, Bijoux & Plus" },
  ]},
  { label: "À Propos",  href: "/about" },
  { label: "Contact",   href: "/contact" },
];
const currentPath = Astro.url.pathname;
---

<header id="main-header" data-mode="scrolled" class="fixed top-0 left-0 right-0 z-50 transition-all duration-400" role="banner">

  <!-- Background layer -->
  <div id="header-bg" class="absolute inset-0 border-b border-transparent transition-all duration-400"></div>

  <!-- Announcement bar (desktop only, inside fixed header) -->
  <div id="announcement-bar" class="hidden lg:block overflow-hidden bg-brown text-cream-light/80 text-center py-2 px-0" style="max-height:40px;">
    <div class="ticker-inner flex items-center gap-16 font-sans text-[10px] tracking-[0.22em] uppercase" style="width:max-content;animation:shimmerScroll 22s linear infinite;">
      {Array(5).fill(null).map(() => (
        <>
          <span class="text-cream-light/80 whitespace-nowrap">✦ Livraison disponible à partir de 2 000 FCFA</span>
          <span class="text-gold/70 whitespace-nowrap">✦ Nouvelle collection automne 2025</span>
          <span class="text-cream-light/80 whitespace-nowrap">✦ Commandes personnalisées disponibles</span>
        </>
      ))}
    </div>
  </div>

  <!-- Main nav -->
  <div class="relative max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 md:h-24">

      <!-- Hamburger -->
      <button
        id="hamburger-btn"
        class="hamburger lg:hidden flex flex-col gap-1.5 p-2 -ml-2 z-50"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        onclick="toggleMobileMenu()"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>

      <!-- Logo SVG inline — currentColor adapts to dark/light context -->
      <a href="/" id="logo-container" class="flex-shrink-0 hover:opacity-80" aria-label="Maison Khoudia" style="color:#D4AF37;">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 185" class="h-14 md:h-16 w-auto" aria-hidden="true">
          <!-- Dress icon -->
          <g transform="translate(14,16)" opacity="0.75">
            <path d="M10 0 L6 7 L0 5 L3 22 L17 22 L20 5 L14 7 Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/>
            <path d="M7 0 Q10 3 13 0" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </g>
          <!-- Handbag icon -->
          <g transform="translate(12,145)" opacity="0.75">
            <rect x="0" y="8" width="22" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <path d="M6 8 C6 2 16 2 16 8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="0" y1="14" x2="22" y2="14" stroke="currentColor" stroke-width="0.8" opacity="0.6"/>
          </g>
          <!-- Heel icon -->
          <g transform="translate(183,14)" opacity="0.75">
            <path d="M2 20 C6 20 11 18 14 13 L18 3 L21 3 L21 5 C18 5 16 10 16 15 C19 15 22 17 22 20 Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/>
          </g>
          <!-- Ring icon -->
          <g transform="translate(184,146)" opacity="0.75">
            <circle cx="11" cy="14" r="9" fill="none" stroke="currentColor" stroke-width="1.2"/>
            <path d="M4 10 L7 4 L15 4 L18 10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            <path d="M7 4 L11 7 L15 4" fill="none" stroke="currentColor" stroke-width="1.0" stroke-linejoin="round"/>
          </g>
          <!-- MK Monogram -->
          <text x="110" y="128" font-family="Georgia,'Times New Roman',serif" font-style="italic" font-weight="700" font-size="100" fill="currentColor" text-anchor="middle" letter-spacing="-3">MK</text>
          <!-- Divider -->
          <line x1="42" y1="152" x2="178" y2="152" stroke="currentColor" stroke-width="0.6" opacity="0.45"/>
          <!-- Brand name -->
          <text x="110" y="171" font-family="Arial,'Helvetica Neue',sans-serif" font-weight="400" font-size="10.5" fill="currentColor" text-anchor="middle" letter-spacing="5.5">MAISON KHOUDIA</text>
        </svg>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-9" role="navigation">
        {navLinks.map(link => (
          link.dropdown ? (
            <div class="dropdown-trigger relative group">
              <a href={link.href} class={`nav-link py-2 flex items-center gap-1 ${currentPath.startsWith('/boutique') ? 'text-gold' : ''}`}>
                {link.label}
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-300 group-hover:rotate-180 mt-0.5"><path d="m6 9 6 6 6-6"/></svg>
              </a>
              <div class="dropdown-menu">
                <div class="py-2">
                  {link.dropdown.map(item => (
                    <a href={item.href} class={`flex flex-col px-5 py-3 hover:bg-cream transition-colors duration-200 ${currentPath === item.href ? 'border-l-2 border-gold bg-cream' : ''}`}>
                      <span class="font-sans text-sm font-medium text-luxury-black">{item.label}</span>
                      <span class="font-sans text-xs text-luxury-gray mt-0.5">{item.desc}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={link.href} class={`nav-link py-2 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-px after:bg-gold after:transition-all after:duration-300 hover:after:w-full ${currentPath === link.href ? 'text-gold after:!w-full' : ''}`}>
              {link.label}
            </a>
          )
        ))}
      </nav>

      <!-- Icons -->
      <div class="flex items-center gap-1">
        <button class="icon-btn w-10 h-10 flex items-center justify-center hover:text-gold transition-colors duration-200" aria-label="Rechercher">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </button>
        <button class="icon-btn hidden sm:flex w-10 h-10 items-center justify-center hover:text-gold transition-colors duration-200" aria-label="Favoris">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        <a href="/boutique" class="hidden sm:flex items-center gap-2 ml-3 px-7 py-2.5 bg-gold text-brown font-sans text-sm font-bold tracking-wide rounded-full hover:bg-gold-dark hover:shadow-luxury-md transition-all duration-300 hover:-translate-y-0.5 whitespace-nowrap">
          Boutique
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Mobile overlay -->
<div id="mobile-overlay" class="fixed inset-0 bg-luxury-black/60 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-400 lg:hidden" onclick="closeMobileMenu()"></div>

<!-- Mobile menu -->
<nav id="mobile-menu" class="mobile-menu lg:hidden" role="navigation" aria-hidden="true">
  <div class="flex items-center justify-between p-6 border-b border-cream-dark">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 185" class="h-14 w-auto" style="color:#D4AF37;" aria-label="Maison Khoudia">
      <g transform="translate(14,16)" opacity="0.75"><path d="M10 0 L6 7 L0 5 L3 22 L17 22 L20 5 L14 7 Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/><path d="M7 0 Q10 3 13 0" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></g>
      <g transform="translate(12,145)" opacity="0.75"><rect x="0" y="8" width="22" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M6 8 C6 2 16 2 16 8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="0" y1="14" x2="22" y2="14" stroke="currentColor" stroke-width="0.8" opacity="0.6"/></g>
      <g transform="translate(183,14)" opacity="0.75"><path d="M2 20 C6 20 11 18 14 13 L18 3 L21 3 L21 5 C18 5 16 10 16 15 C19 15 22 17 22 20 Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/></g>
      <g transform="translate(184,146)" opacity="0.75"><circle cx="11" cy="14" r="9" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4 10 L7 4 L15 4 L18 10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M7 4 L11 7 L15 4" fill="none" stroke="currentColor" stroke-width="1.0" stroke-linejoin="round"/></g>
      <text x="110" y="128" font-family="Georgia,'Times New Roman',serif" font-style="italic" font-weight="700" font-size="100" fill="currentColor" text-anchor="middle" letter-spacing="-3">MK</text>
      <line x1="42" y1="152" x2="178" y2="152" stroke="currentColor" stroke-width="0.6" opacity="0.45"/>
      <text x="110" y="171" font-family="Arial,'Helvetica Neue',sans-serif" font-weight="400" font-size="10.5" fill="currentColor" text-anchor="middle" letter-spacing="5.5">MAISON KHOUDIA</text>
    </svg>
    <button onclick="closeMobileMenu()" class="w-10 h-10 flex items-center justify-center text-luxury-gray hover:text-gold transition-colors" aria-label="Fermer">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto py-4">
    <div class="px-6 space-y-0">
      <a href="/" class="flex items-center py-4 border-b border-cream-dark font-serif text-xl text-luxury-black hover:text-gold transition-colors" onclick="closeMobileMenu()">Accueil</a>
      <div class="border-b border-cream-dark">
        <button id="boutique-toggle" class="flex items-center justify-between w-full py-4 font-serif text-xl text-luxury-black hover:text-gold transition-colors" onclick="toggleBoutiqueMenu()" aria-expanded="false">
          Boutique
          <svg id="boutique-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="boutique-submenu" class="hidden pb-3 space-y-0.5">
          {[
            { label: "Toutes les Collections", href: "/boutique" },
            { label: "Femme",       href: "/boutique/femme" },
            { label: "Homme",       href: "/boutique/homme" },
            { label: "Enfants",     href: "/boutique/enfants" },
            { label: "Accessoires", href: "/boutique/accessoires" },
          ].map(item => (
            <a href={item.href} class="flex items-center gap-2 px-4 py-3 text-sm font-sans text-luxury-gray hover:text-gold hover:bg-cream transition-all" onclick="closeMobileMenu()">
              <span class="w-3 h-px bg-gold flex-shrink-0"></span>
              {item.label}
            </a>
          ))}
        </div>
      </div>
      <a href="/about"   class="flex items-center py-4 border-b border-cream-dark font-serif text-xl text-luxury-black hover:text-gold transition-colors" onclick="closeMobileMenu()">À Propos</a>
      <a href="/contact" class="flex items-center py-4 font-serif text-xl text-luxury-black hover:text-gold transition-colors" onclick="closeMobileMenu()">Contact</a>
    </div>
    <div class="px-6 mt-8 space-y-3">
      <a href="https://wa.me/221785064773" target="_blank" class="btn-primary w-full justify-center gap-3" onclick="closeMobileMenu()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.122.554 4.112 1.523 5.838L0 24l6.337-1.498A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.806 9.806 0 0 1-5.013-1.374l-.36-.213-3.73.881.937-3.613-.234-.37A9.818 9.818 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
        Commander via WhatsApp
      </a>
    </div>
  </div>
</nav>

<style>
  /* Hero mode: transparent header over dark background */
  #main-header[data-mode="hero"] .nav-link      { color: rgba(255,255,255,0.85); }
  #main-header[data-mode="hero"] .nav-link:hover { color: #D4AF37; }
  #main-header[data-mode="hero"] .icon-btn      { color: rgba(255,255,255,0.80); }
  #main-header[data-mode="hero"] .hamburger-line { background: rgba(255,255,255,0.90); }

  /* Scrolled mode: white background */
  #main-header[data-mode="scrolled"] .nav-link      { color: #1A1A1A; }
  #main-header[data-mode="scrolled"] .icon-btn      { color: #1A1A1A; }
  #main-header[data-mode="scrolled"] .hamburger-line { background: #1A1A1A; }

  /* Logo color transitions */
  #logo-container { transition: color 0.4s ease; }

  /* Header background before JS — white on non-hero pages */
  #main-header[data-mode="scrolled"] #header-bg {
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(16px);
    border-color: rgba(0,0,0,0.07);
    box-shadow: 0 2px 20px rgba(0,0,0,0.07);
  }
</style>

<script>
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-overlay');
    const btn = document.getElementById('hamburger-btn');
    if (menu?.classList.contains('open')) { closeMobileMenu(); return; }
    menu?.classList.add('open');
    overlay?.classList.remove('opacity-0','pointer-events-none');
    btn?.classList.add('open'); btn?.setAttribute('aria-expanded','true');
    menu?.setAttribute('aria-hidden','false');
    document.body.style.overflow = 'hidden';
  }
  function closeMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-overlay');
    const btn = document.getElementById('hamburger-btn');
    menu?.classList.remove('open');
    overlay?.classList.add('opacity-0','pointer-events-none');
    btn?.classList.remove('open'); btn?.setAttribute('aria-expanded','false');
    menu?.setAttribute('aria-hidden','true');
    document.body.style.overflow = '';
  }
  function toggleBoutiqueMenu() {
    const sub = document.getElementById('boutique-submenu');
    const arrow = document.getElementById('boutique-arrow');
    const btn = document.getElementById('boutique-toggle');
    const isOpen = !sub?.classList.contains('hidden');
    sub?.classList.toggle('hidden', isOpen);
    arrow?.classList.toggle('rotate-180', !isOpen);
    btn?.setAttribute('aria-expanded', String(!isOpen));
  }

  const headerEl      = document.getElementById('main-header') as HTMLElement;
  const headerBg      = document.getElementById('header-bg') as HTMLElement;
  const annBar        = document.getElementById('announcement-bar') as HTMLElement;
  const logoContainer = document.getElementById('logo-container') as HTMLElement;
  const heroEl        = document.querySelector('.hero') as HTMLElement;

  function applyMode(scrolled: boolean) {
    headerEl.dataset.mode = scrolled ? 'scrolled' : 'hero';

    // Header background
    if (headerBg) {
      headerBg.style.background     = scrolled ? 'rgba(255,255,255,0.97)' : 'transparent';
      headerBg.style.backdropFilter = scrolled ? 'blur(16px)' : 'none';
      headerBg.style.borderColor    = scrolled ? 'rgba(0,0,0,0.07)' : 'transparent';
      headerBg.style.boxShadow      = scrolled ? '0 2px 20px rgba(0,0,0,0.07)' : 'none';
    }

    // Nav links color — force via JS (CSS scoping can be unreliable)
    const navColor   = scrolled ? '#1A1A1A' : 'rgba(255,255,255,0.85)';
    const iconColor  = scrolled ? '#1A1A1A' : 'rgba(255,255,255,0.80)';
    const hamColor   = scrolled ? '#1A1A1A' : 'rgba(255,255,255,0.90)';
    document.querySelectorAll<HTMLElement>('#main-header .nav-link').forEach(el => { el.style.color = navColor; });
    document.querySelectorAll<HTMLElement>('#main-header .icon-btn').forEach(el => { el.style.color = iconColor; });
    document.querySelectorAll<HTMLElement>('#main-header .hamburger-line').forEach(el => { el.style.background = hamColor; });

    // Announcement bar: hide on scroll
    if (annBar) {
      annBar.style.maxHeight  = scrolled ? '0' : '40px';
      annBar.style.opacity    = scrolled ? '0' : '1';
      annBar.style.transition = 'max-height 0.4s ease, opacity 0.3s ease';
      annBar.style.overflow   = 'hidden';
    }

    // Logo: always gold
    if (logoContainer) {
      logoContainer.style.color = '#D4AF37';
    }
  }

  // Initialize: hero mode only on pages that have a .hero section
  const hasHero = !!heroEl;
  applyMode(!hasHero); // scrolled=true when no hero, scrolled=false when hero present

  const threshold = 80;
  window.addEventListener('scroll', () => {
    applyMode(window.scrollY > threshold);
  }, { passive: true });

  (window as any).toggleMobileMenu = toggleMobileMenu;
  (window as any).closeMobileMenu = closeMobileMenu;
  (window as any).toggleBoutiqueMenu = toggleBoutiqueMenu;
</script>
