---
import { formatPrice } from '../data/products.js';
interface Props {
  id: number; name: string; price: number; category: string;
  subcategory?: string; colors?: string[]; sizes?: string[];
  gradient?: string; image?: string; new?: boolean; bestseller?: boolean;
  class?: string; tall?: boolean;
}
const { id, name, price, category, subcategory, gradient = 'img-placeholder-beige', image, new: isNew = false, bestseller = false, class: className = '', tall = false } = Astro.props;
const whatsappPhone = '221785064773';
const whatsappMsg = encodeURIComponent(`Bonjour Maison Khoudia 👋\n\nJe suis intéressé(e) par :\n🛍️ *${name}*\nPrix : ${formatPrice(price)}\n\nMerci !`);
const whatsappUrl = `https://wa.me/${whatsappPhone}?text=${whatsappMsg}`;
const gradientStyles: Record<string,string> = {
  'img-placeholder-pink':  'linear-gradient(170deg,#F8E1E7 0%,#EDD5C0 55%,#D4AF37 100%)',
  'img-placeholder-beige': 'linear-gradient(170deg,#F5EBD8 0%,#E8D5B5 55%,#C9A84C 100%)',
  'img-placeholder-dark':  'linear-gradient(170deg,#2C1810 0%,#4A2C1A 55%,#8B6347 100%)',
  'img-placeholder-rose':  'linear-gradient(170deg,#FADADD 0%,#F5B8C0 55%,#E8968A 100%)',
  'img-placeholder-gold':  'linear-gradient(170deg,#F0E4A0 0%,#D4AF37 55%,#B8962E 100%)',
  'img-placeholder-mauve': 'linear-gradient(170deg,#E8D5E8 0%,#C9A8C9 55%,#9B6B9B 100%)',
  'img-placeholder-navy':  'linear-gradient(170deg,#D5DCE8 0%,#8B9BB5 55%,#2C3E6B 100%)',
  'img-placeholder-sage':  'linear-gradient(170deg,#D5E8D5 0%,#A8C9A8 55%,#6B9B6B 100%)',
};
---
<article class={`editorial-card ${className}`} data-product-id={id} data-wa={whatsappUrl}>
  <div class="img-zone relative overflow-hidden cursor-pointer" style={tall ? 'aspect-ratio:2/3' : 'aspect-ratio:3/4'} onclick={`window.location.href='/produit/${id}'`}>
    {image ? (
      <img src={image} alt={name} class="img-media w-full h-full object-cover object-top transition-transform duration-700 ease-out" loading="lazy" />
    ) : (
      <div class="img-media w-full h-full transition-transform duration-700 ease-out" style={`background: ${gradientStyles[gradient] ?? gradientStyles['img-placeholder-beige']};`}></div>
    )}
    <div class="card-overlay absolute inset-0 bg-black/0 transition-colors duration-400 pointer-events-none"></div>
    {(isNew || bestseller) && (
      <div class="absolute top-3 left-3 z-10 pointer-events-none">
        {isNew && <span class="block px-2.5 py-1 mb-1 bg-white/90 text-luxury-black text-[9px] font-sans font-bold tracking-[0.15em] uppercase">Nouveau</span>}
        {bestseller && <span class="block px-2.5 py-1 bg-gold text-brown text-[9px] font-sans font-bold tracking-[0.15em] uppercase">Best seller</span>}
      </div>
    )}
    <div class="card-cta absolute inset-x-4 bottom-4 z-20 opacity-0 translate-y-2 transition-all duration-300 pointer-events-none">
      <button class="wa-btn flex items-center justify-center gap-2 w-full py-3 bg-white text-luxury-black text-[10px] font-sans font-semibold tracking-[0.15em] uppercase hover:bg-gold hover:text-brown transition-colors duration-200">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.122.554 4.112 1.523 5.838L0 24l6.337-1.498A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.806 9.806 0 0 1-5.013-1.374l-.36-.213-3.73.881.937-3.613-.234-.37A9.818 9.818 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
        Commander
      </button>
    </div>
  </div>
  <div class="pt-3 pb-1">
    {subcategory && <p class="font-sans text-[9px] tracking-[0.2em] uppercase text-gold font-medium mb-1 capitalize">{subcategory}</p>}
    <a href={`/produit/${id}`} class="block">
      <h3 class="font-serif text-[0.95rem] font-medium text-luxury-black leading-snug hover:text-gold transition-colors duration-200 line-clamp-1">{name}</h3>
    </a>
    <p class="font-sans text-[0.8rem] text-luxury-black/60 mt-0.5">{formatPrice(price)}</p>
  </div>
</article>
<script>
  document.querySelectorAll('.editorial-card').forEach(card => {
    const imgZone = card.querySelector('.img-zone');
    const media   = card.querySelector('.img-media');
    const overlay = card.querySelector('.card-overlay');
    const cta     = card.querySelector('.card-cta');
    const waBtn   = card.querySelector('.wa-btn');
    const waUrl   = (card as HTMLElement).dataset.wa ?? '';
    waBtn?.addEventListener('click', e => { e.stopPropagation(); window.open(waUrl,'_blank','noopener,noreferrer'); });
    imgZone?.addEventListener('mouseenter', () => {
      media?.classList.add('scale-[1.04]');
      overlay?.classList.replace('bg-black/0','bg-black/25');
      cta?.classList.remove('opacity-0','translate-y-2','pointer-events-none');
      cta?.classList.add('opacity-100','translate-y-0','pointer-events-auto');
    });
    imgZone?.addEventListener('mouseleave', () => {
      media?.classList.remove('scale-[1.04]');
      overlay?.classList.replace('bg-black/25','bg-black/0');
      cta?.classList.add('opacity-0','translate-y-2','pointer-events-none');
      cta?.classList.remove('opacity-100','translate-y-0','pointer-events-auto');
    });
  });
</script>
