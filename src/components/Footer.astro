---
---
<footer class="bg-luxury-black text-cream-light py-12 sm:py-16 px-5 sm:px-6 lg:px-8">
  <div class="max-w-8xl mx-auto">
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 mb-10 sm:mb-12">
      <div class="col-span-2 sm:col-span-1">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 185" class="h-14 sm:h-16 w-auto mb-4" aria-label="Maison Khoudia" style="color:#D4AF37;">
          <g transform="translate(14,16)" opacity="0.75"><path d="M10 0 L6 7 L0 5 L3 22 L17 22 L20 5 L14 7 Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/><path d="M7 0 Q10 3 13 0" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></g>
          <g transform="translate(12,145)" opacity="0.75"><rect x="0" y="8" width="22" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M6 8 C6 2 16 2 16 8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><line x1="0" y1="14" x2="22" y2="14" stroke="currentColor" stroke-width="0.8" opacity="0.6"/></g>
          <g transform="translate(183,14)" opacity="0.75"><path d="M2 20 C6 20 11 18 14 13 L18 3 L21 3 L21 5 C18 5 16 10 16 15 C19 15 22 17 22 20 Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round"/></g>
          <g transform="translate(184,146)" opacity="0.75"><circle cx="11" cy="14" r="9" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4 10 L7 4 L15 4 L18 10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M7 4 L11 7 L15 4" fill="none" stroke="currentColor" stroke-width="1.0" stroke-linejoin="round"/></g>
          <text x="110" y="128" font-family="Georgia,'Times New Roman',serif" font-style="italic" font-weight="700" font-size="100" fill="currentColor" text-anchor="middle" letter-spacing="-3">MK</text>
          <line x1="42" y1="152" x2="178" y2="152" stroke="currentColor" stroke-width="0.6" opacity="0.45"/>
          <text x="110" y="171" font-family="Arial,'Helvetica Neue',sans-serif" font-weight="400" font-size="10.5" fill="currentColor" text-anchor="middle" letter-spacing="5.5">MAISON KHOUDIA</text>
        </svg>
        <p class="font-sans text-xs text-cream-light/50 leading-relaxed max-w-[28ch]">Haute Mode & Élégance Africaine. Des créations qui subliment la femme moderne.</p>
      </div>
      <div>
        <h4 class="font-serif text-sm font-semibold text-gold mb-4 tracking-wider">Collections</h4>
        <ul class="space-y-2">
          {["Femme","Homme","Enfants","Accessoires"].map(c => (
            <li><a href={`/boutique/${c.toLowerCase()}`} class="font-sans text-xs text-cream-light/60 hover:text-gold transition-colors">{c}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="font-serif text-sm font-semibold text-gold mb-4 tracking-wider">Informations</h4>
        <ul class="space-y-2">
          {[["À Propos","/about"],["Contact","/contact"],["Guide des Tailles","#"],["Livraison","#"]].map(([l,h]) => (
            <li><a href={h} class="font-sans text-xs text-cream-light/60 hover:text-gold transition-colors">{l}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="font-serif text-sm font-semibold text-gold mb-4 tracking-wider">Contact</h4>
        <div class="space-y-2">
          <a href="https://wa.me/221785064773" target="_blank" rel="noopener" class="flex items-center gap-2 font-sans text-xs text-cream-light/60 hover:text-gold transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.122.554 4.112 1.523 5.838L0 24l6.337-1.498A11.944 11.944 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.806 9.806 0 0 1-5.013-1.374l-.36-.213-3.73.881.937-3.613-.234-.37A9.818 9.818 0 0 1 2.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
            +221 78 506 47 73
          </a>
        </div>
      </div>
    </div>
    <div class="border-t border-cream-light/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-sans text-xs text-cream-light/40">© 2025 Maison Khoudia. Tous droits réservés.</p>
      <div class="flex items-center gap-5">
        <!-- TikTok -->
        <a href="https://www.tiktok.com/@maisonkhoudia" target="_blank" rel="noopener" class="text-cream-light/40 hover:text-gold transition-colors" aria-label="TikTok">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.19 8.19 0 0 0 4.79 1.53V6.77a4.85 4.85 0 0 1-1.02-.08z"/></svg>
        </a>
        <!-- Facebook -->
        <a href="https://www.facebook.com/maisonkhoudia" target="_blank" rel="noopener" class="text-cream-light/40 hover:text-gold transition-colors" aria-label="Facebook">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <!-- Instagram -->
        <a href="#" class="text-cream-light/40 hover:text-gold transition-colors" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
